# B 站普通账号 Cookie（浏览器登录后复制），抓 AI 字幕必需
BILI_SESSDATA=
# B 站接口最小请求间隔（秒）
BILI_MIN_INTERVAL=3.0

# ASR 兜底
WHISPER_MODEL=small
WHISPER_DEVICE=auto
DOWNLOADER=bbdown

# LLM（M3 知识提炼）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 飞书（M4）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 任务失败/后台任务完成的通知群（可选）
FEISHU_ALERT_CHAT_ID=

# 管理后台访问口令（设置后 /admin 与 /api 需带 X-Admin-Token 头或 ?token=）
ADMIN_TOKEN=

# 存储
KB_ROOT=./knowledge-base
DB_PATH=./data/pipeline.db
WORK_DIR=./data/work
PROJECT_CONTEXT_FILE=./project-context.md
